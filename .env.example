# ===== Discord =====
# ОБЯЗАТЕЛЬНО: новый токен из Discord Developer Portal (старый из кода перевыпустите!)
DISCORD_TOKEN=вставьте_сюда_токен
# ID текстового канала для логов (0/пусто — логи в канал выключены)
LOG_CHANNEL_ID=
# ID вашего сервера для синхронизации слэш-команд
TEST_GUILD_ID=
# Кто может пользоваться ботом помимо администраторов Discord (whitelist).
# user ID через запятую. Пусто — доступ только у администраторов.
ALLOWED_USER_IDS=

# ===== PostgreSQL =====
POSTGRES_USER=botuser
POSTGRES_PASSWORD=поменяйте_пароль
POSTGRES_DB=botdb

# ===== Google Sheets (экспорт пересчётов 10:55 и 18:55) =====
# ID таблицы — часть URL между /d/ и /edit.
# Оставьте пустым, чтобы выключить экспорт в Google Sheets.
GOOGLE_SHEET_ID=
# Путь к JSON-ключу сервисного аккаунта (в docker — /app/service_account.json).
GOOGLE_SA_JSON=service_account.json
# Экспорт пересчётов в Google Sheets: true/false. По умолчанию false (выключено).
EXPORT2SHEET=false
